:root {
    --bg: #07111f;
    --panel: #0b1728;
    --panel-2: #0f1d31;
    --border: #1b314b;
    --text: #e8f1fa;
    --muted: #7890a8;
    --cyan: #35d4ff;
    --green: #39d98a;
    --red: #ff5577;
    --yellow: #f4c95d;
    --shadow: 0 14px 35px rgba(0, 0, 0, 0.25);
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background:
        radial-gradient(circle at top right, #102b45 0, transparent 34%),
        var(--bg);
    color: var(--text);
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

.app-shell {
    width: min(1500px, calc(100% - 36px));
    margin: 0 auto;
    padding: 24px 0 30px;
}

.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 22px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    background: rgba(11, 23, 40, 0.9);
    box-shadow: var(--shadow);
}

.brand {
    display: flex;
    align-items: center;
    gap: 14px;
}

.brand-icon {
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1px solid var(--cyan);
    color: var(--cyan);
    font-weight: 800;
    letter-spacing: 1px;
}

.brand-title {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

.brand-subtitle {
    margin-top: 4px;
    color: var(--muted);
    font-size: 12px;
}

.system-status {
    display: flex;
    align-items: center;
    gap: 10px;
    text-align: right;
}

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yellow);
    box-shadow: 0 0 14px currentColor;
}

.status-dot.online {
    background: var(--green);
}

.status-dot.offline {
    background: var(--red);
}

.status-label {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1.2px;
}

.status-value {
    margin-top: 3px;
    font-size: 13px;
    font-weight: 800;
}

.kpi-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 12px;
    margin-bottom: 12px;
}

.kpi-card,
.panel {
    border: 1px solid var(--border);
    background: linear-gradient(
        145deg,
        rgba(15, 29, 49, 0.96),
        rgba(8, 19, 33, 0.96)
    );
    box-shadow: var(--shadow);
}

.kpi-card {
    min-height: 132px;
    padding: 18px;
}

.kpi-label {
    color: var(--muted);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.3px;
}

.kpi-value {
    margin-top: 12px;
    font-size: 26px;
    font-weight: 800;
}

.kpi-unit {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
}

.kpi-meta {
    margin-top: 8px;
    color: var(--muted);
    font-size: 11px;
}

.status-normal,
.action-normal {
    color: var(--green);
}

.status-threat,
.action-threat {
    color: var(--red);
}

.chart-grid,
.analysis-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-bottom: 12px;
}

.panel {
    padding: 18px;
    margin-bottom: 12px;
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
}

.panel-title {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.1px;
}

.panel-subtitle {
    margin-top: 4px;
    color: var(--muted);
    font-size: 11px;
}

.panel-badge,
.event-counter {
    border: 1px solid var(--border);
    padding: 6px 9px;
    color: var(--cyan);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
}

.chart-container {
    position: relative;
    height: 285px;
}

.detection-status,
.security-response {
    padding-top: 4px;
}

.detection-label {
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 1px;
}

.detection-value {
    margin-top: 7px;
    font-size: 30px;
    font-weight: 900;
}

.detection-value.normal {
    color: var(--green);
}

.detection-value.threat {
    color: var(--red);
}

.probability-row {
    margin-top: 22px;
}

.probability-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 7px;
    font-size: 12px;
}

.probability-item span {
    color: var(--muted);
}

.probability-bar {
    height: 8px;
    overflow: hidden;
    background: #13243a;
}

.probability-fill {
    height: 100%;
    width: 0%;
    transition: width 0.4s ease;
}

.normal-fill {
    background: var(--green);
}

.threat-fill {
    background: var(--red);
}

.response-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
}

.response-row span {
    color: var(--muted);
}

.response-row strong {
    font-size: 12px;
}

.severity-normal {
    color: var(--green);
}

.severity-high {
    color: var(--red);
}

.response-reason {
    margin-top: 15px;
    padding: 12px;
    border: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.12);
    font-size: 12px;
}

.response-reason-label {
    margin-bottom: 6px;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 1px;
}

.pipeline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.pipeline-node {
    flex: 1;
    text-align: center;
}

.pipeline-icon {
    width: 38px;
    height: 38px;
    margin: 0 auto 8px;
    display: grid;
    place-items: center;
    border: 1px solid var(--cyan);
    color: var(--cyan);
    font-size: 10px;
    font-weight: 800;
}

.pipeline-name {
    font-size: 10px;
    font-weight: 800;
}

.pipeline-state {
    margin-top: 4px;
    color: var(--green);
    font-size: 9px;
    font-weight: 700;
}

.pipeline-arrow {
    color: var(--muted);
    font-size: 18px;
}

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
}

th {
    padding: 11px 10px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.8px;
    text-align: left;
}

td {
    padding: 11px 10px;
    border-bottom: 1px solid rgba(27, 49, 75, 0.55);
}

.empty-state {
    padding: 28px;
    color: var(--muted);
    text-align: center;
}

.event-threat {
    color: var(--red);
    font-weight: 800;
}

.event-normal {
    color: var(--green);
    font-weight: 800;
}

.footer {
    display: flex;
    justify-content: space-between;
    padding: 8px 2px;
    color: var(--muted);
    font-size: 10px;
}

@media (max-width: 1150px) {
    .kpi-grid {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 800px) {
    .chart-grid,
    .analysis-grid {
        grid-template-columns: 1fr;
    }

    .pipeline {
        flex-wrap: wrap;
    }

    .pipeline-arrow {
        display: none;
    }

    .topbar {
        align-items: flex-start;
        gap: 18px;
        flex-direction: column;
    }
}

@media (max-width: 560px) {
    .app-shell {
        width: min(100% - 20px, 1500px);
    }

    .kpi-grid {
        grid-template-columns: 1fr 1fr;
    }

    .kpi-value {
        font-size: 21px;
    }

    .footer {
        flex-direction: column;
        gap: 6px;
    }
}
